# Text handling: this repo is used from WSL/Linux shells AND Windows.
# Shell scripts MUST be LF-only or bash chokes on \r in filenames/commands.
*.sh          text eol=lf diff=sh
# Windows tooling files:
*.ps1         text eol=crlf
*.cmd         text eol=crlf
# Normal text:
*.md          text
*.yml         text
*.yaml        text
*.toml        text
*.json        text
*.sql         text
*.ts          text
*.tsx         text
.js           text
