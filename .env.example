# Copy of the values this project needs to run its local database.
# NEVER commit the real .env file. This example holds ONLY fake values.
#
#   1. Run:  bash scripts/gen-secrets.sh
#      (it creates .env with strong random passwords - nothing to type)
#   2. Or copy this file to .env and edit by hand.

# The name of the database that will be created on first start.
POSTGRES_DB=church

# The owner role. Owns the objects, runs migrations. The API NEVER uses it.
POSTGRES_USER=church_owner

# STRONG password for the owner role. Random characters, 32+. Never reuse one.
POSTGRES_PASSWORD=CHANGE_ME__see_.env.example

# STRONG password for the church_app runtime role (what the API will use in
# Phase 3). Different from the owner password. 24+ random characters.
CHURCH_APP_PASSWORD=CHANGE_ME__see_.env.example

# Where this copy of the system runs: dev = your PC, production = set ONLY
# on the church machine. scripts/db-reset-dev.sh refuses to run and delete
# data unless this says "dev", so the real database can never be wiped by
# accident from a dev machine.
CHURCH_ENV=dev
